@startuml
left to right direction
skinparam packageStyle rectangle

actor "Aspirante" as asp
actor "Reclutador" as rec
actor "Servicio de Correo Externo (API)" as mail << System >>

rectangle "Sistema TalentTrack" {
    usecase "Registrar Perfil (PDF)" as CU1
    usecase "Buscar Ofertas de Empleo" as CU2
    usecase "Postularse a Vacante" as CU3
    usecase "Gestionar Vacantes (Alta/Baja/Modificación)" as CU4
    usecase "Evaluar Candidatos" as CU5
    usecase "Agendar Entrevista Técnica" as CU6
    usecase "Registrar Calificación y Comentarios" as CU7
    usecase "Enviar Notificación Automática" as CU8
}

asp --> CU1
asp --> CU2
asp --> CU3

rec --> CU4
rec --> CU5
rec --> CU6
rec --> CU7

CU3 .> CU8 : <<include>>
CU6 .> CU8 : <<include>>
CU7 .> CU8 : <<include>>

CU8 --> mail
@enduml